generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id           String              @id @default(cuid())
  name         String              @unique
  slug         String              @unique
  ownerEmail   String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  slots        Slot[]
  assignments  PlayerAssignment[]
  transactions RosterTransaction[]
  standings    StandingsSnapshot[]
  emailDeliveries DailyEmailDelivery[]
}

model Slot {
  id           String              @id @default(cuid())
  teamId       String
  number       Int
  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments  PlayerAssignment[]
  cachedTotal  SlotTotal?
  transactions RosterTransaction[]

  @@unique([teamId, number])
}

model Player {
  id                   String              @id @default(cuid())
  mlbPlayerId          Int                 @unique
  fullName             String
  active               Boolean             @default(true)
  assignments          PlayerAssignment[]
  homeRuns             HomeRunEvent[]
  incomingTransactions RosterTransaction[] @relation("IncomingPlayer")
  outgoingTransactions RosterTransaction[] @relation("OutgoingPlayer")
}

model PlayerAssignment {
  id            String   @id @default(cuid())
  playerId      String
  slotId        String?
  teamId        String?
  effectiveDate DateTime @db.Timestamp(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slot   Slot?  @relation(fields: [slotId], references: [id])
  team   Team?  @relation(fields: [teamId], references: [id])

  @@unique([playerId, effectiveDate])
  @@index([playerId, effectiveDate])
  @@index([slotId, effectiveDate])
}

model HomeRunEvent {
  id             String   @id @default(cuid())
  playerId       String
  gameId         Int
  gameDate       DateTime @db.Date
  inning         Int?
  hrNumberInGame Int
  createdAt      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId, hrNumberInGame])
  @@index([gameDate])
}

model SlotTotal {
  slotId        String   @id
  totalHomeRuns Int      @default(0)
  updatedAt     DateTime @updatedAt

  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)
}

model RosterTransaction {
  id            String   @id @default(cuid())
  effectiveDate DateTime @db.Timestamp(3)
  teamId        String
  slotId        String
  playerOutId   String?
  playerInId    String
  notes         String?
  createdAt     DateTime @default(now())

  team      Team    @relation(fields: [teamId], references: [id])
  slot      Slot    @relation(fields: [slotId], references: [id])
  playerOut Player? @relation("OutgoingPlayer", fields: [playerOutId], references: [id])
  playerIn  Player  @relation("IncomingPlayer", fields: [playerInId], references: [id])

  @@index([teamId, effectiveDate])
}

model StandingsSnapshot {
  id         String   @id @default(cuid())
  teamId     String
  asOfDate   DateTime @db.Date
  teamPoints Int
  rank       Int

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, asOfDate])
}

model MlbBackfill {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  nextDate    DateTime @db.Date
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}

model MlbSyncState {
  id        String   @id
  updatedAt DateTime @updatedAt
}

model DailyEmailDelivery {
  id       String   @id @default(cuid())
  teamId   String
  asOfDate DateTime @db.Date
  sentAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, asOfDate])
}
